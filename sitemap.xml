---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in site.pages -%}
  {%- assign ext = p.name | split: "." | last -%}
  {%- if ext == "html" or ext == "markdown" -%}
    {%- unless p.url == "/404.html" %}
  <url><loc>https://{{ site.domain }}{{ p.url | replace: "index.html", "" | replace: ".html", "" }}</loc></url>
    {%- endunless -%}
  {%- endif -%}
{%- endfor -%}
{%- for p in site.posts %}
  <url><loc>https://{{ site.domain }}{{ p.url | replace: ".html", "" }}</loc><lastmod>{{ p.date | date: "%Y-%m-%d" }}</lastmod></url>
{%- endfor %}
</urlset>
